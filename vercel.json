{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p dist/static && cp api/static/index.html dist/ && cp api/static/app.css api/static/app.js dist/static/",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/query", "destination": "https://hhgoa.duckdns.org/query" },
    { "source": "/voice-query", "destination": "https://hhgoa.duckdns.org/voice-query" },
    { "source": "/health", "destination": "https://hhgoa.duckdns.org/health" },
    { "source": "/stats", "destination": "https://hhgoa.duckdns.org/stats" }
  ]
}
