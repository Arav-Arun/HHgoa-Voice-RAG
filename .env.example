# Copy to .env and fill in real values. Never commit .env.

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_PRESET=e5-small
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
# Device for the query encoder and the gate's cross-encoder. Both are small and
# run one item at a time, where CPU beats GPU dispatch overhead (measured
# 5.32 ms vs 7.46 ms). Empty hands the choice to sentence-transformers.
TORCH_DEVICE=cpu

# --- Chunking (fixed | semantic | metadata | recursive | parent_child | token_window) ---
CHUNKING_PROVIDER=fixed
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# parent_child only. Window chosen on the dev slice by `./hhgoa child-sweep`.
CHILD_SENTENCES=3
CHILD_STRIDE=1
# token_window only: sizes are in e5 TOKENS, not characters
TOKEN_CHUNK_SIZE=160
TOKEN_CHUNK_OVERLAP=24

# --- Retrieval ---
VECTOR_STORE=memory
TOP_K=5
# dense | sparse | hybrid
RETRIEVER=hybrid
# Counted in distinct passages, not chunks, so it means the same thing for
# every chunker regardless of fan-out.
RETRIEVAL_CANDIDATE_K=50
# Rank passages rather than chunks. False reproduces the pre-fix ablation.
RETRIEVAL_DEDUPE=true
# rrf (rank-based, scale-free) | zscore
FUSION=rrf
RRF_K=60
FUSION_ALPHA=0.5
# Weighted-RRF dense share, tuned on the dev slice (data/eval/fusion-sweep.json).
# Hindi peaks near-dense; Gujarati needs a real lexical contribution.
FUSION_DENSE_WEIGHT=0.8
FUSION_DENSE_WEIGHT_HI=0.95
FUSION_DENSE_WEIGHT_GU=0.50

DEFAULT_LANGUAGE=hi

# --- LLM (quality path only; the fast path is local and needs no key) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional secondary provider: the harness fails over to this when the primary
# errors. Groq is OpenAI-compatible, so only the host and model id change.
LLM_API_KEY_SECONDARY=
LLM_PROVIDER_SECONDARY=groq
LLM_MODEL_SECONDARY=llama-3.3-70b-versatile

# --- STT (spec requires Sarvam or ElevenLabs; we use ElevenLabs Scribe) ---
STT_PROVIDER=elevenlabs
STT_API_KEY=
STT_BASE_URL=https://api.elevenlabs.io/v1
STT_MODEL=scribe_v2

# --- Guardrails ---
GUARDRAIL_PROVIDER=default
# auto: use the fitted multi-feature gate when data/eval/guardrail-model.json exists.
# threshold: force the plain cosine threshold (ablation / fresh checkout).
GUARDRAIL_MODE=auto
GUARDRAIL_MODEL_PATH=data/eval/guardrail-model.json
GUARDRAIL_MIN_SCORE=0.86
GUARDRAIL_MIN_QUERY_LENGTH=3
GUARDRAIL_MIN_ANSWER_OVERLAP=0.20
# Cross-encoder relevance feature for the grounding gate. Empty disables it and
# the gate falls back to the three lexical/dense features.
GUARDRAIL_CROSS_ENCODER=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Tier-2 answer cache (in-process LRU; 0 disables) ---
ANSWER_CACHE_SIZE=256

# --- Deployment ---
# Prebuilt index tarball, fetched once at boot. See scripts/package_index.py.
INDEX_URL=

# --- API server ---
# Containers must bind 0.0.0.0; hosts assign the port via $PORT.
API_HOST=127.0.0.1
API_PORT=8000
