# Copy to .env and fill in real values. Never commit .env.

# --- RAG pipeline ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_PRESET=e5-small
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE=memory
CHUNKING_PROVIDER=fixed
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
DEFAULT_LANGUAGE=hi

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional fallback provider
LLM_API_KEY_SECONDARY=
LLM_PROVIDER_SECONDARY=

# --- STT (voice path — Hindi + Gujarati; spec: Sarvam or ElevenLabs) ---
STT_PROVIDER=elevenlabs
STT_API_KEY=
STT_BASE_URL=https://api.elevenlabs.io/v1
STT_MODEL=scribe_v2

# --- Guardrails (input intent + grounding/abstain) ---
GUARDRAIL_PROVIDER=default
GUARDRAIL_MIN_SCORE=0.86
GUARDRAIL_MIN_QUERY_LENGTH=3
GUARDRAIL_MIN_ANSWER_OVERLAP=0.20

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
