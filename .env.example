# Copy to .env and fill in real values. Never commit .env.

# --- RAG pipeline ---
EMBEDDING_PROVIDER=hash          # hash | openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=memory              # memory (add faiss/qdrant later)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
DEFAULT_LANGUAGE=hi

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional fallback provider
LLM_API_KEY_SECONDARY=
LLM_PROVIDER_SECONDARY=

# --- STT (voice path, future) ---
STT_API_KEY=
STT_PROVIDER=
STT_MODEL=

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
