# Copy to .env and fill in real values. Never commit .env.

# --- RAG pipeline ---
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | hash | openai
EMBEDDING_PRESET=e5-small                  # e5-small | indic-sbert | bge-m3
EMBEDDING_MODEL=                           # optional override; empty = preset default
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE=memory                        # memory (add faiss/qdrant later)
CHUNKING_PROVIDER=fixed                 # fixed | semantic | metadata
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
DEFAULT_LANGUAGE=hi

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional fallback provider
LLM_API_KEY_SECONDARY=
LLM_PROVIDER_SECONDARY=

# --- STT (voice path — Hindi + Gujarati; spec: Sarvam or ElevenLabs) ---
STT_PROVIDER=elevenlabs                  # elevenlabs | stub | openai (whisper, optional)
STT_API_KEY=                             # ElevenLabs API key (or set ELEVENLABS_API_KEY)
STT_BASE_URL=https://api.elevenlabs.io/v1
STT_MODEL=scribe_v2

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
