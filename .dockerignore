# The index arrives at boot from INDEX_URL, so baking it in would add 320 MB to
# the image and pin it to one corpus build. Use data/** rather than data/ so the
# exception below can still match: excluding the directory itself stops docker
# descending into it.
data/**
# Except 21 KB the serving path reads. Without the first, the gate silently
# falls back to a raw cosine cutoff, which is not the gate any published number
# describes. Without the rest, /stats has nothing to read and the UI shows a
# dash where every measured result should be.
!data/eval/guardrail-model.json
!data/eval/retriever-compare.json
!data/eval/guardrail-calibration.json
!data/bench/latency.json
.venv/
.git/
.github/
.pytest_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
.env
.claude/
docs/
tests/
